#!/bin/bash
# Runs as root, right after Installer.app copies the payload to
# /Library/Application Support/CleanMedia (see scripts/build-pkg.sh). Its only
# job is to get out of root's way as fast as possible and finish the install
# as the actual logged-in person -- Homebrew refuses outright to run as root,
# and everything this needs to touch (uv's install, ~/.local/bin, the venv,
# the launchd LaunchAgent) belongs to that person, not to root.
#
# The one thing that DOES need root is creating a fresh Homebrew prefix
# (/opt/homebrew on Apple Silicon, /usr/local on Intel) -- so this does that
# part itself, chowns it to the console user, and only then drops down. That
# means Homebrew's own installer never has to ask for a second password: the
# one admin prompt Installer.app already showed for this .pkg is the only one
# a friend ever sees. If Homebrew is already installed, none of that runs --
# this only touches a prefix it is about to create itself.
set -u

log() { echo "[postinstall] $*"; }

INSTALL_DIR="/Library/Application Support/CleanMedia"

# --- who is actually sitting at this Mac? ------------------------------------
# The standard, widely-used way to find the logged-in GUI user from a root
# context (Installer.app, launchd, MDM postinstall scripts all use this same
# stat trick) -- correct for a double-clicked .pkg, but there may be no real
# console *login* session at all when this runs some other way (`sudo
# installer` from a terminal, or a CI runner that supports GUI automation
# without an interactive Aqua login tied to /dev/console). For that case,
# fall back to $SUDO_USER, which sudo always sets to whoever actually invoked
# it -- a well-defined "the installing user" in a non-GUI context too.
CONSOLE_USER="$(stat -f "%Su" /dev/console 2>/dev/null || true)"
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ] || [ "$CONSOLE_USER" = "loginwindow" ]; then
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    CONSOLE_USER="$SUDO_USER"
  fi
fi
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ] || [ "$CONSOLE_USER" = "loginwindow" ]; then
  log "no one appears to be logged in at the console -- sign in and re-run the installer."
  exit 1
fi
CONSOLE_UID="$(id -u "$CONSOLE_USER" 2>/dev/null || true)"
CONSOLE_GROUP="$(id -gn "$CONSOLE_USER" 2>/dev/null || echo staff)"
if [ -z "$CONSOLE_UID" ]; then
  log "could not resolve a uid for console user '$CONSOLE_USER'."
  exit 1
fi
log "installing for $CONSOLE_USER (uid $CONSOLE_UID)"

# --- the payload is root-owned straight off the copy; hand it over ----------
chown -R "$CONSOLE_USER:$CONSOLE_GROUP" "$INSTALL_DIR"

# --- pre-authorize a fresh Homebrew prefix, so its installer needs no sudo --
# (`command` is a shell builtin, not a standalone binary -- sudo can only exec
# real binaries, so this has to go through a shell rather than call it directly.)
if ! sudo -u "$CONSOLE_USER" -H bash -lc 'command -v brew' >/dev/null 2>&1; then
  # Prefer actual filesystem evidence over `uname -m` for picking the prefix:
  # under Rosetta translation a translated process's uname -m reports the
  # emulated architecture, not the real hardware (build-pkg.sh's
  # hostArchitectures declaration avoids that translation happening at all,
  # but this stays robust even if some other path ends up translated too).
  if [ -e /opt/homebrew ]; then BREW_PREFIX="/opt/homebrew"
  elif [ -e /usr/local/Homebrew ] || [ -e /usr/local/bin/brew ]; then BREW_PREFIX="/usr/local"
  elif [ "$(uname -m)" = "arm64" ]; then BREW_PREFIX="/opt/homebrew"
  else BREW_PREFIX="/usr/local"
  fi
  if [ ! -e "$BREW_PREFIX" ]; then
    log "creating $BREW_PREFIX, owned by $CONSOLE_USER, so Homebrew's installer needs no extra password"
    mkdir -p "$BREW_PREFIX"
    chown -R "$CONSOLE_USER:$CONSOLE_GROUP" "$BREW_PREFIX"
  else
    log "$BREW_PREFIX already exists (not owned by $CONSOLE_USER via brew) -- leaving it alone;"
    log "Homebrew's installer may need a password it cannot ask for here. See the log if it fails."
  fi
fi

# --- open a Terminal so progress is visible without hunting for a log file --
# install.sh takes several minutes (uv downloads PyTorch, Ollama pulls a
# multi-GB model) and Installer.app's own window just shows a generic
# "running package scripts" spinner the whole time -- it cannot show this
# script's output live. `open -a Terminal` on a plain text file does not tail
# it (Terminal has no such behavior for arbitrary files) -- a .command file is
# what Terminal.app actually knows how to run, so wrap the tail in one. And a
# bare `sudo -u user open ...` from a root context has no window-server
# connection and silently does nothing; launchctl asuser is what actually
# opens a GUI app in another user's session.
#
# The tail window and install.sh below run concurrently (fire the window,
# then run the install), with no direct link between them -- so a status
# *file*, written after install.sh finishes, is how the window knows to react
# instead of just tailing forever. On success it tries to close itself; on
# failure it stays open with the one thing a non-technical friend needs to
# know: which file to send back.
LOGFILE="$INSTALL_DIR/install.log"
STATUS_FILE="$INSTALL_DIR/.install-status"
: > "$LOGFILE"
rm -f "$STATUS_FILE"
chown "$CONSOLE_USER:$CONSOLE_GROUP" "$LOGFILE"

TAIL_CMD="$INSTALL_DIR/.watch-install.command"
cat > "$TAIL_CMD" <<TAILEOF
#!/bin/bash
LOGFILE="$LOGFILE"
STATUS_FILE="$STATUS_FILE"
echo "Clean Media is installing -- this can take several minutes the first time"
echo "(it downloads a vision-AI model and some dependencies)."
echo
tail -f -n +1 "\$LOGFILE" &
tailpid=\$!
while [ ! -f "\$STATUS_FILE" ]; do sleep 1; done
sleep 1
kill "\$tailpid" 2>/dev/null
wait "\$tailpid" 2>/dev/null
echo
status="\$(cat "\$STATUS_FILE" 2>/dev/null)"
if [ "\$status" = "0" ]; then
  echo "All done -- you're set up. A \"Clean Media Worker\" icon on the Desktop"
  echo "manages it from here (status, restart, media folder, GPU hosts)."
  echo "This window will close itself in a few seconds."
  sleep 5
  osascript -e "tell application \"Terminal\" to close (every window whose tty is \"\$(tty)\")" >/dev/null 2>&1 &
else
  echo "Something went wrong (exit code \${status:-unknown}). This is not something"
  echo "to troubleshoot yourself -- copy this window's text (or the log file this"
  echo "just revealed in Finder) and send it to whoever gave you this installer."
  open -R "\$LOGFILE" >/dev/null 2>&1 || true
fi
TAILEOF
chmod +x "$TAIL_CMD"
chown "$CONSOLE_USER:$CONSOLE_GROUP" "$TAIL_CMD"
launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" \
  open -a Terminal "$TAIL_CMD" >/dev/null 2>&1 || log "could not open a visible progress window (non-fatal)"

# --- run the real installer as the console user, not root -------------------
# No tty here, so scripts/install.sh's own `[ ! -t 0 ]` fallback already makes
# every prompt take its default -- --yes is belt-and-suspenders, matching how
# scripts/build-dmg.sh's .command runs the interactive version of this same
# script. -H sets HOME to the console user's, which uv/ollama/launchd all need
# to land in the right place.
sudo -u "$CONSOLE_USER" -H bash -lc "cd '$INSTALL_DIR' && bash scripts/install.sh --yes" >>"$LOGFILE" 2>&1
status=$?
echo "$status" > "$STATUS_FILE"
chown "$CONSOLE_USER:$CONSOLE_GROUP" "$STATUS_FILE"

if [ "$status" -eq 0 ]; then
  log "install.sh finished — see $LOGFILE for the full run"
else
  log "install.sh exited $status — see $LOGFILE (still open in Terminal) for why"
fi
exit "$status"
